<?xml version="1.0" encoding="utf-8"?>
<!-- A filter chip: quiet until chosen, then the blue one above. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vmore_blue_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vmore_surface" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/vmore_stroke" />
        </shape>
    </item>
</ripple>
