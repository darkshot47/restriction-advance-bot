<?xml version="1.0" encoding="utf-8"?>
<!-- The second button: an outline, the same radius, a blue wash on touch. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/vmore_blue_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vmore_blue_ghost" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/vmore_blue" />
        </shape>
    </item>
</ripple>
