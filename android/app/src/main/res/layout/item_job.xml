<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="10dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/jobIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ic_folder"
            android:contentDescription="@string/common_file" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/jobTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/vmore_text"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/jobStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreSubtitle"
                android:maxLines="2" />
        </LinearLayout>

        <TextView
            android:id="@+id/jobPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:textColor="@color/vmore_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/jobProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:progressDrawable="@drawable/bg_progress"
        android:max="100"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/jobUp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_up"
            android:contentDescription="@string/queue_move_up" />

        <ImageView
            android:id="@+id/jobDown"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_down"
            android:contentDescription="@string/queue_move_down" />

        <Button
            android:id="@+id/jobAction"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            style="@style/VmoreButtonFlat"
            android:text="@string/queue_pause" />

        <Button
            android:id="@+id/jobOpen"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            style="@style/VmoreButtonFlat"
            android:text="@string/queue_open"
            android:visibility="gone" />

        <Button
            android:id="@+id/jobRemove"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            style="@style/VmoreButtonFlat"
            android:text="@string/queue_remove" />
    </LinearLayout>
</LinearLayout>
