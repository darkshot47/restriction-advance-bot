<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vmore_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="30dp">

        <!-- Header: the account on the right, the screens on the row below -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/VmoreTitle"
                        android:text="@string/home_title" />

                    <TextView
                        android:id="@+id/accountText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/VmoreSubtitle"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profileBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/profile_gap"
                    android:paddingRight="2dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/profileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="130dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/vmore_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/profileUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="130dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:paddingTop="1dp"
                            android:textColor="@color/vmore_text_faint"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginLeft="6dp">

                        <!-- The same story ring as the logo, turning slowly. -->
                        <com.vmore.app.StoryRingView
                            android:id="@+id/profileRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ImageView
                            android:id="@+id/profileAvatar"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_avatar"
                            android:padding="9dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_person"
                            android:contentDescription="@string/home_nav_profile" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <ImageView
                    android:id="@+id/themeButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_moon"
                    android:contentDescription="@string/home_nav_theme" />

                <ImageView
                    android:id="@+id/queueButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_queue"
                    android:contentDescription="@string/home_nav_queue" />

                <ImageView
                    android:id="@+id/historyButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_history"
                    android:contentDescription="@string/home_nav_history" />

                <ImageView
                    android:id="@+id/filesButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_folder"
                    android:contentDescription="@string/files_title" />

                <ImageView
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/home_nav_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- Destination -->
        <LinearLayout
            android:id="@+id/destCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="14dp"
                android:src="@drawable/ic_chat"
                android:contentDescription="@string/home_send_to" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/VmoreSection"
                    android:text="@string/home_send_to" />

                <TextView
                    android:id="@+id/destTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vmore_text"
                    android:textSize="16sp"
                    android:text="@string/home_no_destination" />
            </LinearLayout>

            <Button
                android:id="@+id/destButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/VmoreButtonGhost"
                android:minHeight="40dp"
                android:text="@string/home_change" />
        </LinearLayout>

        <!-- Links + options -->
        <LinearLayout
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/VmoreSection"
                android:text="@string/home_links_label" />

            <EditText
                android:id="@+id/linkField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreField"
                android:minLines="3"
                android:gravity="top|start"
                android:inputType="textMultiLine|textUri"
                android:hint="@string/home_links_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pasteButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="@style/VmoreButtonGhost"
                    android:text="@string/home_paste" />

                <Button
                    android:id="@+id/clearButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="@style/VmoreButtonGhost"
                    android:text="@string/home_clear" />

                <Button
                    android:id="@+id/scanButton"
                    android:layout_width="0dp"
                    android:layout_weight="1.25"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="@style/VmoreButtonGhost"
                    android:text="@string/home_scan_chat" />
            </LinearLayout>

            <!--
              What a batch does, laid out exactly like the Settings page: one
              switch per row with a soft divider under it, then three rows that
              carry an icon, the name of the choice and the value in force.
              Nothing here competes for a line with anything else.
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/VmoreSection"
                android:text="@string/home_options_label" />

            <LinearLayout
                android:id="@+id/optionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowUpload"
                    style="@style/VmoreOptionRow">

                    <TextView
                        style="@style/VmoreOptionTitle"
                        android:text="@string/home_option_upload" />

                    <Switch
                        android:id="@+id/switchUpload"
                        style="@style/VmoreOptionSwitch" />
                </LinearLayout>

                <View style="@style/VmoreOptionDivider" />

                <LinearLayout
                    android:id="@+id/rowDelete"
                    style="@style/VmoreOptionRow">

                    <TextView
                        style="@style/VmoreOptionTitle"
                        android:text="@string/home_option_delete" />

                    <Switch
                        android:id="@+id/switchDelete"
                        style="@style/VmoreOptionSwitch" />
                </LinearLayout>

                <View style="@style/VmoreOptionDivider" />

                <LinearLayout
                    android:id="@+id/rowForward"
                    style="@style/VmoreOptionRow">

                    <TextView
                        style="@style/VmoreOptionTitle"
                        android:text="@string/home_option_forward" />

                    <Switch
                        android:id="@+id/switchForward"
                        style="@style/VmoreOptionSwitch" />
                </LinearLayout>

                <View style="@style/VmoreOptionDivider" />

                <LinearLayout
                    android:id="@+id/rowQuality"
                    style="@style/VmoreOptionRow">

                    <ImageView
                        style="@style/VmoreOptionIcon"
                        android:src="@drawable/ic_image"
                        android:contentDescription="@string/home_option_quality" />

                    <TextView
                        style="@style/VmoreOptionTitle"
                        android:text="@string/home_option_quality" />

                    <TextView
                        android:id="@+id/valueQuality"
                        style="@style/VmoreOptionValue"
                        android:text="@string/settings_send_as_file" />

                    <ImageView
                        style="@style/VmoreOptionChevron"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@string/home_change" />
                </LinearLayout>

                <View style="@style/VmoreOptionDivider" />

                <LinearLayout
                    android:id="@+id/rowFilter"
                    style="@style/VmoreOptionRow">

                    <ImageView
                        style="@style/VmoreOptionIcon"
                        android:src="@drawable/ic_search"
                        android:contentDescription="@string/home_option_filter" />

                    <TextView
                        style="@style/VmoreOptionTitle"
                        android:text="@string/home_option_filter" />

                    <TextView
                        android:id="@+id/valueFilter"
                        style="@style/VmoreOptionValue"
                        android:text="@string/filters_all" />

                    <ImageView
                        style="@style/VmoreOptionChevron"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@string/home_change" />
                </LinearLayout>

                <View style="@style/VmoreOptionDivider" />

                <LinearLayout
                    android:id="@+id/rowSchedule"
                    style="@style/VmoreOptionRow">

                    <ImageView
                        style="@style/VmoreOptionIcon"
                        android:src="@drawable/ic_history"
                        android:contentDescription="@string/home_option_schedule" />

                    <TextView
                        style="@style/VmoreOptionTitle"
                        android:text="@string/home_option_schedule" />

                    <TextView
                        android:id="@+id/valueSchedule"
                        style="@style/VmoreOptionValue"
                        android:text="@string/home_schedule_now" />

                    <ImageView
                        style="@style/VmoreOptionChevron"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@string/home_change" />
                </LinearLayout>
            </LinearLayout>

            <!-- The clipboard banner: a Telegram link is one tap away. -->
            <LinearLayout
                android:id="@+id/clipboardBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/clipboardText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textColor="@color/vmore_text_dim"
                    android:textSize="12.5sp"
                    android:text="@string/home_clipboard_found" />

                <Button
                    android:id="@+id/clipboardAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    style="@style/VmoreChipActive"
                    android:text="@string/home_clipboard_add" />
            </LinearLayout>

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                style="@style/VmoreButton"
                android:text="@string/home_start" />
        </LinearLayout>

        <!-- Live progress -->
        <LinearLayout
            android:id="@+id/progressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/progressName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/vmore_text"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/progressStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreSubtitle"
                android:layout_marginTop="2dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:progressDrawable="@drawable/bg_progress"
                android:max="100" />

            <TextView
                android:id="@+id/progressPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreLabel"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pauseButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    style="@style/VmoreButtonGhost"
                    android:text="@string/queue_pause_all" />

                <Button
                    android:id="@+id/stopQueueButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    style="@style/VmoreButtonGhost"
                    android:text="@string/queue_remove" />
            </LinearLayout>
        </LinearLayout>

        <!-- Recent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                style="@style/VmoreSection"
                android:text="@string/home_recent" />

            <Button
                android:id="@+id/viewAllButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/VmoreButtonFlat"
                android:text="@string/home_view_all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/VmoreSubtitle"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="@string/home_empty" />
    </LinearLayout>
</ScrollView>
