<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vmore_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/brandBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_vmore"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                style="@style/VmoreTitle"
                android:textSize="30sp"
                android:text="@string/login_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/VmoreSubtitle"
                android:text="@string/login_tagline" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                android:id="@+id/stepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreTitle"
                android:textSize="18sp"
                android:text="@string/login_step_credentials" />

            <TextView
                android:id="@+id/stepHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/VmoreSubtitle"
                android:text="@string/login_credentials_help" />

            <EditText
                android:id="@+id/apiIdField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreField"
                android:inputType="number"
                android:hint="@string/login_step_credentials"
                android:visibility="gone" />

            <EditText
                android:id="@+id/apiHashField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreField"
                android:inputType="text"
                android:hint="api_hash"
                android:visibility="gone" />

            <EditText
                android:id="@+id/phoneField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreField"
                android:inputType="phone"
                android:hint="+91 90000 00000"
                android:visibility="gone" />

            <EditText
                android:id="@+id/codeField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreField"
                android:inputType="number"
                android:hint="12345"
                android:visibility="gone" />

            <EditText
                android:id="@+id/passwordField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreField"
                android:inputType="textPassword"
                android:hint="@string/login_step_password"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loginProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                style="@style/VmoreButton"
                android:text="@string/login_continue" />

            <Button
                android:id="@+id/linkButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreButtonGhost"
                android:text="@string/login_open_my_telegram" />

            <Button
                android:id="@+id/apiButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreButtonGhost"
                android:text="@string/login_try_ready" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/VmoreButtonGhost"
                android:text="@string/login_change_keys"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            style="@style/VmoreSubtitle"
            android:textSize="12sp"
            android:text="Your session stays on this phone. Vmore sends nothing to any server." />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/VmoreLabel" />
    </LinearLayout>
</ScrollView>
