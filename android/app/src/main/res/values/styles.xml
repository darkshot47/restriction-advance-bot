<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VmoreTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vmore_bg</item>
        <item name="android:colorAccent">@color/vmore_accent</item>
        <item name="android:statusBarColor">@color/vmore_bg</item>
        <item name="android:textColorPrimary">@color/vmore_text</item>
        <item name="android:textColorSecondary">@color/vmore_text_dim</item>
    </style>

    <style name="VmoreCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="VmoreLabel">
        <item name="android:textColor">@color/vmore_text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="VmoreTitle">
        <item name="android:textColor">@color/vmore_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VmoreButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="VmoreButtonAccent" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_accent</item>
        <item name="android:textColor">#062113</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="VmoreField">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/vmore_text</item>
        <item name="android:textColorHint">@color/vmore_text_dim</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
</resources>
